# Runtime artifacts
logs/*
!logs/.gitkeep
captures/*
results/.tmp/
# HackRF IQ captures (~30 MB/s); reports and plots next to them are kept
results/rf/**/*.iq
results/rf/selftest/
!captures/.gitkeep
# Real SIM keys / secrets never go to git (Phase 2+)
secrets/
*.key
__pycache__/
configs/open5gs/upf_picore.yaml
configs/open5gs/amf_picore.yaml
results/picore/**/*_completo.pcap
