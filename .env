# Variables que docker-compose.yml y los scripts leen automáticamente.

# Versiones fijadas (nunca "latest", para que el laboratorio sea reproducible)
OPEN5GS_VERSION=2.7.7          # imágenes gradiant/open5gs y gradiant/open5gs-webui
MONGO_VERSION=6.0              # imagen mongo

# Perfil de ancho de banda de la radio: 10, 15 o 20 (MHz). Elige
# configs/gnb/gnb_zmq_<BW>mhz.yml y configs/ue/ue_zmq_<BW>mhz.conf. También: `BW=20 make up`
BW_MHZ=10

# Reparto de núcleos de CPU (este PC tiene 16 hilos: 0-15). El ZMQ de srsRAN hace "busy-wait"
# (consume CPU esperando muestras); si comparte núcleos con el core, las NFs se ralentizan y el
# registro del UE expira. Por eso cada bloque tiene los suyos.
CORE_CPUS=0-3,14-15            # NFs de Open5GS, MongoDB, WebUI, dn
GNB_CPUS=4-9                   # gNB
UE_CPUS=10-13                  # UE

# Segundo archivo de configuración del gNB, cargado encima del perfil de radio. El de fábrica no
# cambia nada; scripts/measure.sh lo reemplaza para fijar el MCS o encender las métricas por consola.
GNB_OVERRIDES=./configs/gnb/gnb_overrides.yml
