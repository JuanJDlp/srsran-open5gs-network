# Variables del lado Raspberry Pi en el modo "core en la Pi" (scripts/picore.sh). Se cargan DESPUÉS de .env
# (docker compose --env-file .env --env-file picore-pi.env), así que reemplazan sus valores.

# Imágenes de Open5GS compiladas en la Pi (gradiant no publica ARM64); mismo tag 2.7.7
OPEN5GS_IMAGE=siscom/open5gs                 # images/open5gs (NFs, compilado de v2.7.7)
OPEN5GS_WEBUI_IMAGE=siscom/open5gs-webui     # images/open5gs-webui (WebUI, compilado de v2.7.7)

# En este modo la Pi solo lleva el core: sus 4 núcleos (0-3) son para las NFs, MongoDB, WebUI y dn
CORE_CPUS=0-3                  # todo el core
GNB_CPUS=0-3                   # el gNB no corre en la Pi; valor válido solo para que Compose no se queje
UE_CPUS=0-3                    # ídem para el UE
