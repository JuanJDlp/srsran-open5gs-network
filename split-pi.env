# Variables del lado Raspberry Pi en el despliegue distribuido. Se cargan DESPUÉS de .env
# (docker compose --env-file .env --env-file split-pi.env), así que reemplazan sus valores.

# Imágenes de Open5GS compiladas en la Pi (gradiant no publica ARM64); mismo tag 2.7.7
OPEN5GS_IMAGE=siscom/open5gs                 # images/open5gs (NFs, compilado de v2.7.7)
OPEN5GS_WEBUI_IMAGE=siscom/open5gs-webui     # images/open5gs-webui (WebUI, compilado de v2.7.7)

# La Pi 5 tiene 4 núcleos (0-3): mitad para el core y mitad para el gNB, que hace "busy-wait" en ZMQ
CORE_CPUS=0-1                  # NFs de Open5GS, MongoDB, WebUI, dn
GNB_CPUS=2-3                   # gNB
UE_CPUS=0-3                    # el UE no corre en la Pi; valor válido solo para que Compose no se queje

# Solo el perfil de 10 MHz: es la tasa de muestreo más baja que acepta srsUE (11.52 Msps)
BW_MHZ=10
